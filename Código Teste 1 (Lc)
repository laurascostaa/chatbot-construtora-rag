{
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook-waha",
        "options": {}
      },
      "id": "trigger-waha",
      "name": "Recebe Whats (WAHA)",
      "type": "n8n-nodes-base.webhook",
      "position": [0, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "chatId",
              "value": "={{ $json.body.payload.from }}"
            },
            {
              "name": "mensagemCliente",
              "value": "={{ $json.body.payload.body }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-dados",
      "name": "Organizar Dados",
      "type": "n8n-nodes-base.set",
      "position": [220, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.mensagemCliente }}",
              "operation": "regex",
              "value2": "(?i)(atendente|humano|pessoa|rescisão|rescisao|procon|jurídico|juridico|advogado|processo|justiça|reclamação)"
            }
          ]
        }
      },
      "id": "filtro-sensivel",
      "name": "É Assunto Crítico/Transbordo?",
      "type": "n8n-nodes-base.if",
      "position": [420, 300],
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-pdf",
      "name": "Baixar PDF da LongView",
      "type": "n8n-nodes-base.httpRequest",
      "position": [680, 460],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "Você é a assistente virtual de luxo da construtora LongView Empreendimentos. Seu tom é impecável, polido, empático e extremamente formal.\n\nREGRA 1: Baseie suas respostas EXCLUSIVAMENTE nos manuais e PDFs fornecidos através da sua ferramenta de busca.\nREGRA 2: NUNCA invente informações, metragens, prazos ou regras contratuais que não estejam no documento.\nREGRA 3: Se o cliente perguntar algo que NÃO ESTÁ no PDF, responda EXATAMENTE com a palavra: TRANSBORDO_NECESSARIO (não escreva mais nada além dessa palavra)."
        }
      },
      "id": "ai-agent",
      "name": "Assistente LongView (IA)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [940, 460],
      "typeVersion": 1
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.output }}",
              "operation": "contains",
              "value2": "TRANSBORDO_NECESSARIO"
            }
          ]
        }
      },
      "id": "filtro-resposta",
      "name": "IA Pediu Transbordo?",
      "type": "n8n-nodes-base.if",
      "position": [1320, 460],
      "typeVersion": 1
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/sendText",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chatId",
              "value": "={{ $('Organizar Dados').item.json.chatId }}"
            },
            {
              "name": "text",
              "value": "Compreendo perfeitamente. Como se trata de uma solicitação mais específica que exige atenção redobrada, estou a transferir o seu contacto agora mesmo para um dos nossos especialistas LongView. Por gentileza, aguarde um instante."
            },
            {
              "name": "session",
              "value": "default"
            }
          ]
        },
        "options": {}
      },
      "id": "waha-transbordo",
      "name": "WAHA (Mensagem de Transbordo)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [940, 160],
      "typeVersion": 4.1
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/sendText",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "chatId",
              "value": "={{ $('Organizar Dados').item.json.chatId }}"
            },
            {
              "name": "text",
              "value": "={{ $json.output }}"
            },
            {
              "name": "session",
              "value": "default"
            }
          ]
        },
        "options": {}
