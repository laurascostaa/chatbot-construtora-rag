        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst payload = body.payload || body;\nconst from = payload.from || payload.chatId || body.from || '';\nconst messageText = (payload.body || payload.text || '').trim();\nconst sessionName = body.session || 'default';\nconst isFromMe = payload.fromMe || false;\nconst isGroup = from.includes('@g.us');\nif (isFromMe || isGroup) return [{ json: { skip: true } }];\nconst cleanPhone = from.replace('@c.us', '').replace('@s.whatsapp.net', '');\nconst msgLower = messageText.toLowerCase().trim();\n\n// DETECÇÃO DE MÍDIA\nconst type = payload.type || body.type || '';\nconst hasMedia = payload.hasMedia || ['audio', 'ptt', 'image', 'video', 'sticker', 'document'].includes(type) || (!messageText && type);\nconst isMedia = !!hasMedia;\n\nconst isReactivation = ['#bot', '/bot', '#ativar', '/ativar'].includes(msgLower);\nconst greetingRegex = /^(oi|ol[aá]|boa tarde|bom dia|boa noite|hey|hello|tudo bem|tudo bom|e a[ií]|oie|oii)[\\s!?.]*$/i;\nconst isGreeting = greetingRegex.test(messageText.trim()) && !isMedia;\nconst criticalRegex = /(atendente|humano|pessoa|rescis[aã]o|procon|jur[ií]dico|advogado|processo|justi[çc]a|reclama[çc][aã]o|cancelar|cancelamento|distrato|falar com algu[eé]m|quero falar)/i;\nconst isCritical = criticalRegex.test(messageText) && !isMedia;\nreturn [{ json: { skip: false, from, phone: cleanPhone, message: messageText, session: sessionName, isReactivation, isGreeting, isCritical, isMedia, timestamp: new Date().toISOString() } }];"
