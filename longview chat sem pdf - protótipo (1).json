        448,
        816
      ],
      "id": "1f2f0a8d-21bb-4f57-b788-a06ac8cce761"
    },
    {
      "parameters": {
        "jsCode": "const base = $('Switch').first().json;\nconst trechos = $input.all().map(i => i.json.document?.pageContent).filter(Boolean);\nconst chunks = trechos.length ? trechos.map((t, i) => `[Trecho ${i + 1}]\\n${t}`).join('\\n\\n') : '(nenhum trecho encontrado nos documentos)';\nreturn [{ json: { ...base, chunks } }];"
      },
      "name": "Juntar trechos",
