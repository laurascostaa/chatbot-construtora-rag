    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base = $('Edit Fields').item.json;\nconst key = 'dedup_' + String(base.payload_id || '').replace(/[^A-Za-z0-9]/g, '');\nconst count = Number($input.item.json[key] ?? 0);\nreturn { json: { ...base, dedupCount: count } };"
      },
