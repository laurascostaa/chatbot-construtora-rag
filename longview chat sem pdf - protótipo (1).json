      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        0
      ],
      "id": "d5c3fbcd-e4d9-49a9-9097-31f3a19f7919"
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  for (const bin of Object.values(item.binary || {})) {\n    out.push({ json: { arquivo: bin.fileName }, binary: { data: bin } });\n  }\n}\nreturn out;"
      },
