    {
      "parameters": {
        "jsCode": "const qdrantResult = $input.first().json;\nconst results = qdrantResult.result || [];\nconst prevNode = $('Montar Query Enriquecida').first().json;\nconst MIN_SCORE = 0.72;\nconst validResults = results.filter(r => r.score >= MIN_SCORE);\nconst hasContext = validResults.length > 0;\nconst topScore = results.length > 0 ? results[0].score : 0;\nconst contextText = validResults.map(r => `Documento: ${r.payload?.source || 'Material LongView'}\\nTrecho: ${r.payload?.text || r.payload?.pageContent || ''}\\n(Relevância: ${(r.score * 100).toFixed(0)}%)`).join('\\n\\n---\\n\\n');\nreturn [{ json: { ...prevNode, hasContext, contextText, shouldHandoff: !hasContext, topScore, handoffReason: !hasContext ? 'sem_contexto_suficiente' : null } }];"
