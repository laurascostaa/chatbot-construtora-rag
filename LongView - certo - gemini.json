    {
      "parameters": {
        "jsCode": "const from = $input.first().json.from;\nconst session = $input.first().json.session;\nconst hour = new Date().getHours();\nconst greetings = [\n  'Bom dia! Bem-vindo à LongView 🏢\\n\\nSou o assistente virtual e estou aqui para te ajudar com informações sobre nossos empreendimentos de alto padrão.\\n\\nComo posso te auxiliar?',\n  'Boa tarde! Bem-vindo à LongView 🏢\\n\\nSou o assistente virtual e estou aqui para te ajudar com informações sobre nossos empreendimentos de alto padrão.\\n\\nComo posso te auxiliar?',\n  'Boa noite! Bem-vindo à LongView 🏢\\n\\nSou o assistente virtual e estou aqui para te ajudar com informações sobre nossos empreendimentos de alto padrão.\\n\\nComo posso te auxiliar?'\n];\nconst idx = hour < 12 ? 0 : hour < 18 ? 1 : 2;\n// Ajustado para 'chatId' para alimentar direto o WAHA sem erros\nreturn [{ json: { chatId: from, session, text: greetings[idx] } }];"
      },
