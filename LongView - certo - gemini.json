      "parameters": {
        "jsCode": "const geminiResp = $input.first().json;\nconst contextData = $('Preparar Contexto Histórico').first().json;\nconst reformulada = geminiResp.candidates?.[0]?.content?.parts?.[0]?.text?.trim() || contextData.originalMessage;\nreturn [{ json: { ...contextData, message: reformulada, messageOriginal: contextData.originalMessage } }];"
