    {
      "parameters": {
        "jsCode": "const ATTENDANT_PHONE = 'SEU_NUMERO_AQUI@c.us';\nconst from = $('Verificar Estado').first().json.from;\nconst session = $('Verificar Estado').first().json.session;\nconst question = $('Verificar Estado').first().json.message;\nconst isCritical = $('Verificar Estado').first().json.isCritical || false;\nconst topScore = $input.first().json.topScore || 0;\nconst handoffReason = isCritical ? 'assunto_critico' : ($input.first().json.handoffReason || 'sem_contexto');\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.humanHandoff) staticData.humanHandoff = {};\nconst alreadyInHandoff = !!staticData.humanHandoff[from];\nstaticData.humanHandoff[from] = { since: new Date().toISOString(), reason: handoffReason };\nconst reasonLabel = {\n  assunto_critico: '🔴 Assunto crítico (jurídico/rescisão/procon)',\n  sem_contexto_suficiente: '🟡 Fora da base de conhecimento',\n  sem_contexto: '🟡 Fora da base de conhecimento'\n}[handoffReason] || '🟡 Motivo não identificado';\nconst attendantMsg = alreadyInHandoff ? `📩 *Nova mensagem — cliente em atendimento*\\n\\n*Cliente:* ${from.replace('@c.us','')}\\n*Mensagem:* \"${question}\"` : `🔔 *Novo Transbordo — LongView*\\n\\n*Cliente:* ${from.replace('@c.us','')}\\n*Última mensagem:* \"${question}\"\\n*Motivo:* ${reasonLabel}\\n*Score RAG:* ${(topScore*100).toFixed(0)}%\\n*Horário:* ${new Date().toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'})}\\n\\nPara reativar a IA após atender, envie *#bot*.`;\nreturn [{ json: { from, session, clientMessage: alreadyInHandoff ? null : 'Compreendo perfeitamente. Estou transferindo você agora para um dos nossos especialistas LongView para garantir o melhor atendimento. Em breve entraremos em contato! 🏢', attendantMessage: attendantMsg, attendantPhone: ATTENDANT_PHONE, handoffReason, topScore, alreadyInHandoff } }];"
      },
