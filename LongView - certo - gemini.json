    {
      "parameters": {
        "jsCode": "const qdrantResp = $input.first().json;\nconst points = qdrantResp.result?.points || [];\nconst parsedData = $('Verificar Estado').first().json;\nconst currentMessage = parsedData.message;\nconst sorted = [...points].sort((a, b) => new Date(a.payload.timestamp) - new Date(b.payload.timestamp));\nconst historyLines = sorted.map(p => `Cliente: ${p.payload.pergunta_cliente || ''}\\nAssistente: ${(p.payload.resposta_ia || '').slice(0, 200)}`).join('\\n\\n');\nconst hasHistory = historyLines.trim().length > 0;\nreturn [{ json: { ...parsedData, hasHistory, historyLines, originalMessage: currentMessage } }];"
      },
