    {
      "parameters": {
        "method": "POST",
        "url": "(https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent)",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"system_instruction\": {\n    \"parts\": [{\n      \"text\": \"Você é o assistente virtual da LongView, construtora de empreendimentos de alto padrão.\\n\\nSUA ÚNICA FUNÇÃO: reformular o TRECHO abaixo com linguagem acolhedora, elegante e gramaticalmente perfeita para responder à PERGUNTA DO CLIENTE.\\n\\nREGRAS ABSOLUTAS:\\n1. Use SOMENTE as informações presentes no TRECHO fornecido.\\n2. Se o TRECHO não contiver a resposta, responda: 'Não tenho essa informação nos nossos materiais. Vou acionar um especialista LongView para te atender com mais detalhes.'\\n3. NUNCA invente valores, datas ou dados ausentes.\\n4. NUNCA use conhecimento geral.\\n5. Seja cordial e breve. Máximo 4 frases.\\n6. Não mencione que é IA.\"\n    }]\n  },\n  \"contents\": [{ \"role\": \"user\", \"parts\": [{ \"text\": \"TRECHO EXTRAÍDO:\\n{{ $json.contextText }}\\n\\n---\\n\\nPERGUNTA DO CLIENTE:\\n{{ $json.messageOriginal }}\" }] }],\n  \"generationConfig\": { \"temperature\": 0, \"maxOutputTokens\": 512, \"topP\": 1, \"topK\": 1 }\n}",
        "options": {}
      },
