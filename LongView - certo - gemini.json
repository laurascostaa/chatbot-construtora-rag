      "parameters": {
        "jsCode": "const geminiResponse = $input.first().json;\nconst stateNode = $('Verificar Estado').first().json;\nlet responseText = geminiResponse.candidates?.[0]?.content?.parts?.[0]?.text || 'Desculpe, ocorreu um erro ao processar sua mensagem. Um de nossos especialistas entrará em contato.';\n\nreturn [{ json: { \n  chatId: stateNode.from,  // Mudado de 'to' para 'chatId'\n  phone: stateNode.phone, \n  session: stateNode.session, \n  text: responseText.trim(), // Mudado de 'responseText' para 'text'\n  originalMessage: stateNode.message, \n  timestamp: stateNode.timestamp || new Date().toISOString(), \n  topScore: $('Validação de Confiança').first().json.topScore || 0, \n  contextText: $('Validação de Confiança').first().json.contextText || '' \n} }];"
