        "method": "POST",
        "url": "(https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent)",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendHeaders": true,
        "headerParameters": {
