        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"system_instruction\": {\n    \"parts\": [{\n      \"text\": \"Você é um reformulador de perguntas. Sua única tarefa é: dado um HISTÓRICO de conversa e uma NOVA PERGUNTA, reescrever a nova pergunta de forma completa e autocontida.\\n\\nREGRAS:\\n- Se a pergunta já for completa, retorne-a sem alterações.\\n- Retorne APENAS a pergunta reformulada.\"\n    }]\n  },\n  \"contents\": [{ \"role\": \"user\", \"parts\": [{ \"text\": \"HISTÓRICO:\\n{{ $json.hasHistory ? $json.historyLines : 'Sem histórico.' }}\\n\\nNOVA PERGUNTA:\\n{{ $json.originalMessage }}\\n\\nPERGUNTA REFORMULADA:\" }] }],\n  \"generationConfig\": { \"temperature\": 0, \"maxOutputTokens\": 128 }\n}",
        "options": {}
