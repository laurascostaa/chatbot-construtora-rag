    {
      "parameters": {
        "jsCode": "const qdrantResult = $input.first().json;\nconst results = qdrantResult.result || [];\nconst prevNode = $('Verificar Estado').first().json;\n\n// VALIDAÇÃO DE CONFIANÇA\nconst hasContext = results.length > 0;\nconst contextText = results.map(r => `Documento: ${r.payload?.source || 'Manual'}\\nTrecho: ${r.payload?.text || ''}`).join('\\n\\n');\n\nconst shouldHandoff = !hasContext || prevNode.messageCount > 5;\n\n// Reseta contador se a IA for responder bem\nif (hasContext && prevNode.messageCount <= 5) {\n  const staticData = $getWorkflowStaticData('global');\n  if (staticData.messageCount) staticData.messageCount[prevNode.from] = 0;\n}\n\nreturn [{\n  json: {\n    ...prevNode,\n    hasContext: hasContext,\n    contextText: contextText,\n    shouldHandoff: shouldHandoff,\n    reason: !hasContext ? 'sem_contexto' : 'limite_mensagens'\n  }\n}];"
      },
      "id": "e32f388c-dcf4-41fe-9ac9-ec7c97943d2f",
