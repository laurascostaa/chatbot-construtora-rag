        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"system_instruction\": {\n    \"parts\": [{\n      \"text\": \"Você é APENAS um formatador de texto elegante para a construtora de luxo LongView.\\n\\nREGRA DE OURO:\\nUtilize as informações do CONTEXTO abaixo para responder à PERGUNTA. Reescreva de forma acolhedora, polida e gramaticalmente perfeita.\\n\\nPROIBIDO:\\nNão invente NADA. Não adicione informações que não estão no contexto.\"\n    }]\n  },\n  \"contents\": [{\n    \"role\": \"user\",\n    \"parts\": [{\n      \"text\": \"CONTEXTO EXTRAÍDO DO PDF:\\n{{ $json.contextText }}\\n\\n---\\n\\nPERGUNTA DO CLIENTE:\\n{{ $json.message }}\"\n    }]\n  }],\n  \"generationConfig\": { \"temperature\": 0 }\n}",
        "options": {}
      },
