      "name": "IA Reescreve (SEM criar)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        624
      ],
      "notes": "Aqui a IA não pensa, apenas formata o texto do Qdrant. Temperatura 0."
