    {
      "parameters": {
        "jsCode": "const from = $('Verificar Estado').first().json.from;\nconst session = $('Verificar Estado').first().json.session;\nconst question = $('Verificar Estado').first().json.message;\nlet reasonText = 'Necessidade de intervenção humana (Assunto Crítico ou Falta de Contexto)';\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.humanHandoff) staticData.humanHandoff = {};\nstaticData.humanHandoff[from] = { since: new Date().toISOString() };\n\nreturn [{\n  json: {\n    from: from,\n    session: session,\n    clientMessage: 'Compreendo perfeitamente. Estou a transferir o seu contacto agora mesmo para um dos nossos especialistas LongView para garantir a melhor tratativa.',\n    attendantMessage: `🔔 *Transbordo LongView*\\n\\n*Cliente:* ${from.replace('@c.us','')}\\n*Última mensagem:* \"${question}\"\\n\\nResponda neste número. Para reativar a IA, envie *#bot*.`,\n    attendantPhone: 'SEU_NUMERO_AQUI@c.us'\n  }\n}];"
      },
