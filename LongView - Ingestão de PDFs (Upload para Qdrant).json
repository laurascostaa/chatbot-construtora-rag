      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst payload = body.payload || body;\nconst from = payload.from || payload.chatId || body.from || '';\nconst messageText = (payload.body || payload.text || '').trim();\nconst sessionName = body.session || 'default';\nconst isFromMe = payload.fromMe || false;\nconst isGroup = from.includes('@g.us');\n\nif (isFromMe || isGroup) {\n  return [{ json: { skip: true } }];\n}\n\nconst cleanPhone = from.replace('@c.us', '').replace('@s.whatsapp.net', '');\nconst msgLower = messageText.toLowerCase();\n\n// COMANDOS DE REATIVAÇÃO (Atendente)\nconst isReactivation = ['#bot', '/bot'].includes(msgLower);\n\n// CLASSIFICADOR 1: Intenção Crítica / Humana\n// Se o cliente falar de processo, procon, distrato, ou pedir atendente.\nconst criticalRegex = /(atendente|humano|pessoa|rescisão|rescisao|procon|jurídico|juridico|advogado|processo|justiça|reclamação)/i;\nconst isCritical = criticalRegex.test(messageText);\n\nreturn [{\n  json: {\n    skip: false,\n    from: from,\n    phone: cleanPhone,\n    message: messageText,\n    session: sessionName,\n    isReactivation: isReactivation,\n    isCritical: isCritical\n  }\n}];"
      },
