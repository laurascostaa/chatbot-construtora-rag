{
  "name": "LongView - Chatbot (RAG Avançado + Transbordo)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "waha-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "waha-webhook",
      "name": "WAHA - Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 400],
      "webhookId": "waha-longview-chatbot",
      "notes": "Configure no WAHA: POST para http://n8n:5678/webhook/waha-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst payload = body.payload || body;\nconst from = payload.from || payload.chatId || body.from || '';\nconst messageText = (payload.body || payload.text || '').trim();\nconst messageType = payload.type || body.type || 'chat';\nconst sessionName = body.session || 'default';\nconst isFromMe = payload.fromMe || false;\nconst isGroup = from.includes('@g.us');\n\nif (isFromMe || isGroup) {\n  return [{ json: { skip: true, reason: isFromMe ? 'própria mensagem' : 'grupo' } }];\n}\n\nconst cleanPhone = from.replace('@c.us', '').replace('@s.whatsapp.net', '');\n\n// Detecta comando de reativação do bot pelo ATENDENTE\nconst reactivationCommands = ['#bot', '/bot', '#ativar', '/ativar'];\nconst isReactivation = reactivationCommands.includes(messageText.toLowerCase());\n\n// Detecta pedido de humano pelo CLIENTE\nconst humanKeywords = ['atendente', 'humano', 'corretor', 'pessoa', 'falar com alguem', 'falar com alguém', 'quero falar', 'me ligue', 'ligação', 'ligar'];\nconst clientWantsHuman = humanKeywords.some(kw => messageText.toLowerCase().includes(kw));\n\nreturn [{\n  json: {\n    skip: false,\n    from: from,\n    phone: cleanPhone,\n    message: messageText,\n    messageType: messageType,\n    session: sessionName,\n    isReactivation: isReactivation,\n    clientWantsHuman: clientWantsHuman,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "parse-waha",
      "name": "Parsear Mensagem WAHA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [300, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "skip-check",
              "leftValue": "={{ $json.skip }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-skip",
      "name": "Mensagem válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [500, 400]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "ok",
        "options": {}
      },
      "id": "skip-response",
      "name": "Ignorar (skip)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [700, 650]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "reactivation-check",
              "leftValue": "={{ $json.isReactivation }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-reactivation",
      "name": "É reativação do bot?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 400]
    },
    {
      "parameters": {
        "jsCode": "const from = $input.first().json.from;\nconst session = $input.first().json.session;\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.humanHandoff) staticData.humanHandoff = {};\n\nif (staticData.humanHandoff[from]) {\n  delete staticData.humanHandoff[from];\n}\n\nreturn [{\n  json: {\n    to: from,\n    session: session,\n    responseText: '✅ Atendimento virtual reativado para este contato.'\n  }\n}];"
      },
      "id": "reactivate-bot",
      "name": "Reativar Bot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "jsCode": "const from = $input.first().json.from;\nconst clientWantsHuman = $input.first().json.clientWantsHuman;\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.humanHandoff) staticData.humanHandoff = {};\nif (!staticData.messageCount) staticData.messageCount = {};\n\nif (!staticData.messageCount[from]) staticData.messageCount[from] = 0;\nstaticData.messageCount[from]++;\n\nconst isInHumanMode = !!staticData.humanHandoff[from];\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    isInHumanMode: isInHumanMode,\n    messageCount: staticData.messageCount[from]\n  }\n}];"
      },
      "id": "check-human-mode",
      "name": "Verificar Modo Atendimento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "human-mode-check",
              "leftValue": "={{ $json.isInHumanMode }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-human-mode",
      "name": "Bot pausado para este número?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 400]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "ok",
        "options": {}
      },
      "id": "human-mode-passthrough",
      "name": "Silêncio (atendente responde)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1300, 250]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "wants-human-check",
              "leftValue": "={{ $json.clientWantsHuman }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-wants-human",
      "name": "Cliente quer atendente?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1300, 400]
    },
    {
      "parameters": {
        "jsCode": "const from = $input.first().json.from;\nconst session = $input.first().json.session;\nconst question = $input.first().json.message;\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.humanHandoff) staticData.humanHandoff = {};\nstaticData.humanHandoff[from] = {\n  since: new Date().toISOString(),\n  reason: 'pedido_cliente',\n  lastMessage: question\n};\nif (staticData.messageCount) staticData.messageCount[from] = 0;\n\nreturn [{\n  json: {\n    from: from,\n    session: session,\n    question: question,\n    clientMessage: '🙋 Claro! Entendi que você precisa de um atendimento mais específico. Estou transferindo você para um de nossos especialistas agora mesmo.',\n    attendantMessage: `🔔 *Transbordo LongView*\\n\\n*Cliente:* ${from.replace('@c.us','')}\\n*Motivo:* Solicitou atendente humano\\n*Última mensagem:* \"${question}\"\\n\\nResponda neste número. Para reativar a IA, envie *#bot*.`,\n    attendantPhone: 'SEU_NUMERO_AQUI@c.us'\n  }\n}];"
      },
      "id": "prepare-handoff-explicit",
      "name": "Preparar Transbordo (pedido cliente)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1600, 200]
    },
    {
      "parameters": {
        "url": "https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-pdf",
      "name": "Baixar PDF da LongView",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1600, 480],
      "notes": "Coloque aqui a URL pública onde está o PDF dos padrões da construtora"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Parsear Mensagem WAHA').item.json.message }}",
        "options": {
          "systemMessage": "Você é a assistente virtual de luxo da construtora LongView Empreendimentos. Seu tom é impecável, polido, empático e extremamente formal.\n\nREGRA 1: Baseie suas respostas EXCLUSIVAMENTE nos manuais e PDFs fornecidos através da sua ferramenta de busca.\nREGRA 2: NUNCA invente informações, metragens, prazos ou regras contratuais que não estejam no documento.\nREGRA 3: Se o cliente perguntar algo que NÃO ESTÁ no PDF, responda EXATAMENTE com a palavra: TRANSBORDO_NECESSARIO (não escreva mais nada além dessa palavra)."
        }
      },
      "id": "ai-agent",
      "name": "Assistente LongView (IA)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [1820, 480]
    },
