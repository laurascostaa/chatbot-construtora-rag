    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "e2e92c2d-9477-4df8-b57f-d309062dfc96",
              "leftValue": "={{ $json.output }}",
              "rightValue": "TRANSBORDO_NECESSARIO",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            },
            {
              "id": "b3e92c2d-9477-4df8-b57f-d309062dfc97",
              "leftValue": "={{ $('Verificar Modo Atendimento').item.json.messageCount }}",
              "rightValue": 5,
              "operator": {
                "type": "number",
                "operation": "largerEqual"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "filtro-resposta",
      "name": "IA Pediu Transbordo / Limite Excedido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2260, 480],
      "notes": "Verifica se a IA devolveu a palavra-chave OU se passou de 5 mensagens."
    },
    {
      "parameters": {
        "jsCode": "const from = $('Parsear Mensagem WAHA').item.json.from;\nconst session = $('Parsear Mensagem WAHA').item.json.session;\nconst question = $('Parsear Mensagem WAHA').item.json.message;\nconst iaOutput = $input.first().json.output;\n\nlet reason = 'limite_mensagens';\nif (iaOutput && iaOutput.includes('TRANSBORDO_NECESSARIO')) {\n  reason = 'sem_contexto_no_pdf';\n}\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.humanHandoff) staticData.humanHandoff = {};\nstaticData.humanHandoff[from] = {\n  since: new Date().toISOString(),\n  reason: reason,\n  lastMessage: question\n};\nif (staticData.messageCount) staticData.messageCount[from] = 0;\n\nconst reasonText = reason === 'sem_contexto_no_pdf' \n  ? 'Dúvida não encontrada nos PDFs da construtora'\n  : 'Cliente enviou mais de 5 mensagens sem resolução';\n\nreturn [{\n  json: {\n    from: from,\n    session: session,\n    clientMessage: 'Compreendo perfeitamente. Como se trata de uma solicitação mais específica que exige atenção redobrada, estou a transferir o seu contacto agora mesmo para um dos nossos especialistas LongView.',\n    attendantMessage: `🔔 *Transbordo Automático LongView*\\n\\n*Cliente:* ${from.replace('@c.us','')}\\n*Motivo:* ${reasonText}\\n*Última mensagem:* \"${question}\"\\n\\nResponda neste número. Para reativar a IA, envie *#bot*.`,\n    attendantPhone: 'SEU_NUMERO_AQUI@c.us'\n  }\n}];"
      },
      "id": "prepare-handoff-auto",
      "name": "Preparar Transbordo (IA)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2520, 280]
    },
